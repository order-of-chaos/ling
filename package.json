{
  "name": "@orderofchaos/ling",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "description": "i18n library for React with translation extraction",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "clean": "pnpm -r clean",
    "lint": "pnpm build:packages && pnpm lint:eslint && pnpm -r --if-present lint:types",
    "lint:eslint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:types": "pnpm build:packages && pnpm -r --if-present lint:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "pack:packages": "pnpm build:packages && pnpm -r --filter './packages/*' pack --pack-destination /tmp/orderofchaos-ling-pack",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build:packages && pnpm -r --filter './packages/*' publish --access public --no-git-checks"
  },
  "size-limit": [
    {
      "name": "@orderofchaos/ling-core",
      "path": "packages/core/dist/index.js",
      "limit": "2 KB"
    },
    {
      "name": "@orderofchaos/ling-react",
      "path": "packages/react/dist/index.js",
      "limit": "4 KB"
    }
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@orderofchaos/eslint-plugin-ling": "workspace:*",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/react": "^14.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "happy-dom": "^13.0.0",
    "size-limit": "^12.1.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
