{
  "name": "@orderofchaos/ling-cli",
  "version": "0.2.0",
  "description": "CLI for extracting translations from source code",
  "type": "module",
  "bin": {
    "ling": "./dist/bin.js",
    "ling-scan": "./dist/bin.js",
    "ling-lint": "./dist/lint.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:types": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@orderofchaos/ling-core": "workspace:*",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "i18n",
    "cli",
    "translations",
    "extract"
  ],
  "author": "Order of Chaos",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/order-of-chaos/ling/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/order-of-chaos/ling/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/order-of-chaos/ling.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
