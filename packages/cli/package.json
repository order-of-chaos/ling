{
  "name": "@orderofchaos/ling-cli",
  "version": "0.1.0",
  "description": "CLI for extracting translations from source code",
  "type": "module",
  "bin": {
    "ling": "./dist/bin.js",
    "ling-scan": "./dist/bin.js",
    "ling-lint": "./dist/lint.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@orderofchaos/ling-core": "workspace:*",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "i18n",
    "cli",
    "translations",
    "extract"
  ],
  "author": "Order of Chaos",
  "license": "MIT",
  "homepage": "https://github.com/nicetomytyuk/orderofchaos-ling/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/nicetomytyuk/orderofchaos-ling/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicetomytyuk/orderofchaos-ling.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
