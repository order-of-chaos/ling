{
  "name": "@orderofchaos/ling",
  "version": "0.1.0",
  "description": "Complete Ling package with React bindings, core utilities, CLI tools, and ESLint rules",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "ling": "./dist/bin.js",
    "ling-scan": "./dist/bin.js",
    "ling-lint": "./dist/lint.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    },
    "./eslint-plugin": {
      "types": "./dist/eslint-plugin.d.ts",
      "import": "./dist/eslint-plugin.js",
      "require": "./dist/eslint-plugin.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:types": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@orderofchaos/eslint-plugin-ling": "workspace:*",
    "@orderofchaos/ling-cli": "workspace:*",
    "@orderofchaos/ling-core": "workspace:*",
    "@orderofchaos/ling-react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "i18n",
    "react",
    "internationalization",
    "localization",
    "translations",
    "cli",
    "eslint"
  ],
  "author": "Order of Chaos",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/order-of-chaos/ling/tree/main/packages/ling#readme",
  "bugs": {
    "url": "https://github.com/order-of-chaos/ling/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/order-of-chaos/ling.git",
    "directory": "packages/ling"
  },
  "publishConfig": {
    "access": "public"
  }
}
