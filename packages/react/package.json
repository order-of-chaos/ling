{
  "name": "@orderofchaos/ling-react",
  "version": "0.2.0",
  "description": "React bindings for @orderofchaos/ling-core",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:types": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@orderofchaos/ling-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "i18n",
    "react",
    "internationalization",
    "localization",
    "hooks"
  ],
  "author": "Order of Chaos",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/order-of-chaos/ling/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/order-of-chaos/ling/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/order-of-chaos/ling.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  }
}
