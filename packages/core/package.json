{
  "name": "@orderofchaos/ling-core",
  "version": "0.1.0",
  "description": "Core i18n types and utilities",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "translations"
  ],
  "author": "Order of Chaos",
  "license": "MIT",
  "homepage": "https://github.com/nicetomytyuk/orderofchaos-ling/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/nicetomytyuk/orderofchaos-ling/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicetomytyuk/orderofchaos-ling.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
